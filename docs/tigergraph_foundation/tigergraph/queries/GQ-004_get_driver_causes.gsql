/*
 * GQ-004 — get_driver_causes
 * Purpose: The controlled cause vocabulary — the SINGLE source of driver
 *          display metadata (FIX_SPEC_R8 A). The UI's glossary, driver tags
 *          and evidence labels all render display_name / description /
 *          computation from this query; driver names are never hardcoded.
 * Outputs: causes vertex set (ordered by display_order). Each row's
 *          attributes include cause_id (permanent internal key),
 *          display_name, description, computation, default_data_source.
 * Created: V2 build 2026-07-20. Updated R8 2026-07-24 (new attributes flow
 *          automatically via the whole-vertex PRINT). NEEDS LIVE REINSTALL
 *          after the schema change adds the three attributes.
 * Ordering: display_order is declared INT (01_vertices.gsql) so this ORDER BY
 *          is NUMERIC. A live graph installed before that declaration holds
 *          display_order as STRING and this same ORDER BY sorts it
 *          LEXICOGRAPHICALLY ("1","10",…,"19","2") — that graph must be
 *          reinstalled from the current DDL. The API layer independently
 *          re-imposes numeric order (V2RevenueService.driver_causes) so the
 *          glossary renders correctly either way, but the live schema should
 *          still be fixed at the next reinstall.
 * Compatibility target: TigerGraph 4.2.x, classic GSQL SYNTAX V1.
 */
USE GRAPH iperform_v2_revenue

CREATE QUERY get_driver_causes() FOR GRAPH iperform_v2_revenue SYNTAX V1 {
    all_causes = {phx_dm_v2_driver_cause.*};
    causes = SELECT c
        FROM all_causes:c
        ORDER BY c.display_order ASC;
    PRINT causes;
}

INSTALL QUERY get_driver_causes
